#!/bin/bash
# harness CLI 엔트리. git-style: harness <verb> [args]

set -euo pipefail

VERSION="0.0.1"
HARNESS_HOME="$HOME/.harness"
CMD_DIR="$HARNESS_HOME/bin/cmd"

usage() {
  cat <<USAGE
harness $VERSION — generalized harness engineering CLI

Usage:
  harness <command> [args]

Commands (MVP):
  init                   현재 디렉토리에 .harness/ 초기 설정
  link <provider>         provider hook 시스템에 등록 (claude/codex)
  unlink <provider>       등록 해제
  list                   가용/설치 plugin + provider 통합 아티팩트 목록
  show <name>            특정 아티팩트 상세 (--provider / --kind 필터)
  disable <name>         아티팩트 비활성화 (--provider / --kind, --dry-run)
  enable <name>          아티팩트 활성화 (--provider / --kind, --dry-run)
  validate               compose.yaml v2 + manifests + roles 통합 검증
  ralph <start|status|list|stop>  무인 루프 러너
  reload                 resolved.md 재생성
  doctor                 설정·의존성·등록 진단
  version                버전 정보

Commands (v1 → v2 재정의 예정 — 아직 v1 logic):
  scaffold <name>...     템플릿을 프로젝트에 복사
  publish <path>         know-how → 글로벌 standard 로 promote
  viz <type>             시각화 (workflow/subagents/bottleneck/dashboard)
  eval <list|run|report> 하네스 동작 평가 (회귀 테스트)
  improve                사용 패턴 분석 + compose 조정 제안
  judge <run|status>     LLM-as-judge 정성 평가

Run 'harness <command> --help' for command-specific help.
USAGE
}

if [[ $# -eq 0 ]]; then
  usage
  exit 0
fi

cmd="$1"
shift

case "$cmd" in
  -h|--help|help) usage; exit 0 ;;
  init|link|unlink|list|show|disable|enable|validate|publish|scaffold|viz|eval|improve|judge|ralph|reload|doctor|version)
    script="$CMD_DIR/$cmd.sh"
    if [[ -x "$script" ]]; then
      exec "$script" "$@"
    else
      echo "Error: $cmd 미구현" >&2
      exit 1
    fi
    ;;
  *)
    echo "Error: unknown command '$cmd'" >&2
    usage
    exit 1
    ;;
esac
